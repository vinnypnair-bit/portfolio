# electronicsAI Environment Variables Example
# Copy this file to .env.local for local development.
# NEVER commit real API keys or secrets to version control.

# Active AI Provider (options: 'auto', 'openai', 'gemini', 'anthropic', 'offline')
AI_PROVIDER=auto

# Provider API Keys (Fill in your preferred provider key)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Application Environment Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
